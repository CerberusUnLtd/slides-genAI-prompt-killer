// ==UserScript==
// @name         Google Slides - Auto-Dismiss & Canvas Layout Fix
// @namespace    violentmonkey-scripts
// @version      22.0
// @description  Hides the "Enhance this slide" AI nudge (via two independent selectors) and overrides Slides canvas layout constraints. Includes a lightweight tripwire that warns + self-heals if Google ever changes the markup.
// @match        https://docs.google.com/presentation/*
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  // Two independent signals for the nudge: its class family, and its
  // aria-label. If Google renames one, the other likely still catches it.
  const NUDGE_SELECTOR =
    '[class*="appsElementsGenerativeAiNudge"], [aria-label="Enhance this slide"]';

  // CSS alone reliably hides matches - native, zero JS cost per element.
  GM_addStyle(`
    .docs-butterbar-container,
    .docs-material-banner-container,
    ${NUDGE_SELECTOR} {
      display: none !important;
      height: 0 !important;
      min-height: 0 !important;
    }

    #workspace-container,
    .docs-editor-container,
    .docs-editor {
      bottom: 0 !important;
      height: auto !important;
    }
  `);

  // Tripwire: every few seconds (not on every DOM mutation), check whether
  // anything matching the nudge selectors is still actually visible. This
  // only fires if BOTH selectors above have stopped matching a real nudge
  // element (i.e. Google changed the markup) - it force-removes it and
  // warns loudly, so a future break is obvious instead of silent.
  setInterval(() => {
    document.querySelectorAll(NUDGE_SELECTOR).forEach((el) => {
      if (getComputedStyle(el).display !== 'none') {
        console.warn(
          '[AI-nudge-fix] CSS rule no longer hiding this element - selectors may need updating:',
          el
        );
        el.remove();
      }
    });
  }, 5000);

  // Slides needs a `resize` event to recompute its SVG canvas after our CSS
  // changes the workspace container's box size. A ResizeObserver scoped to
  // that one element only fires on real size changes - far cheaper than a
  // subtree MutationObserver reacting to every DOM mutation in the editor.
  function watchResize() {
    const target = document.querySelector('#workspace-container, .docs-editor-container');
    if (!target) {
      setTimeout(watchResize, 250); // container not mounted yet, try again shortly
      return;
    }
    let raf;
    new ResizeObserver(() => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
    }).observe(target);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', watchResize);
  } else {
    watchResize();
  }
})();
