// ==UserScript==
// @name         Google Slides - Auto-Dismiss "Enhance this slide" nudge
// @namespace    violentmonkey-scripts
// @version      2.1
// @description  Hides the AI nudge instantly via CSS, then programmatically clicks its own built-in "Close" button so Slides runs its native dismiss logic (and correctly reclaims the reserved canvas space) instead of us patching container sizes ourselves.
// @match        https://docs.google.com/presentation/*
// @grant        GM_addStyle
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  const NUDGE_SELECTOR = [
    '#canvas-nudge-surface-soy-container',
    '[id^="canvas-nudge-surface"]',
    '[class*="CanvasNudgeSurface"]',
    '[class*="appsElementsGenerativeAiNudge"]',
    '[aria-label="Enhance this slide"]',
  ].join(', ');

  // Hide immediately so there's never a visible flash. GM_addStyle doesn't
  // depend on document.body, so this part is safe to run at document-start.
  GM_addStyle(`${NUDGE_SELECTOR} { display: none !important; }`);

  const CLOSE_SELECTOR = '[aria-label="Close Enhance this slide"]';
  const dismissed = new WeakSet();

  function dismissNudges() {
    document.querySelectorAll(CLOSE_SELECTOR).forEach((btn) => {
      if (dismissed.has(btn)) return;
      dismissed.add(btn);
      btn.click();
      console.log('[Slides nudge fix] dismissed nudge via its own Close button:', btn);
    });
  }

  // observer.observe requires document.body to exist. At document-start it
  // may not yet - wait for DOMContentLoaded if so, instead of crashing.
  function start() {
    const observer = new MutationObserver(dismissNudges);
    observer.observe(document.body, { childList: true, subtree: true });
    setInterval(dismissNudges, 1000);
    dismissNudges();
  }

  if (document.body) {
    start();
  } else {
    document.addEventListener('DOMContentLoaded', start);
  }
})();
